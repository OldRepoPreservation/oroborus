default: all
clean:
	test "`find . -name Makefile.in`" && find . -name Makefile.in | xargs rm || true
	rm -rf autom4te.cache
	rm -f configure
	rm -f aclocal.m4
	rm -f src/stamp-h.in

all:
	aclocal
	autoconf
	autoheader
	automake -a

generate-tags:
	find -iname '*.c' -print0 -o -iname '*.h' -print0 | xargs -0 ctags -f functions
	find -iname '*.c' -print0 -o -iname '*.h' -print0 | xargs -0 ctags

remove-tags:
	find -iname 'tags' -print0 -o -iname 'functions' -print0 | xargs -0 rm
